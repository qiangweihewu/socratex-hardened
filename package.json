{
  "name": "socratex",
  "description": "Hardened Socratex HTTPS forward proxy fork",
  "version": "2.0.21",
  "private": true,
  "homepage": "https://github.com/qiangweihewu/socratex-hardened",
  "main": "index.mjs",
  "type": "module",
  "bin": {
    "socratex": "main.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node main.mjs",
    "debug": "node --inspect --trace-warnings main.mjs --http --debug",
    "test": "node --test tests/*.test.mjs",
    "docker-build": "docker build -t socratex-hardened:local .",
    "test:external": "node test.mjs"
  },
  "keywords": [
    "http-proxy",
    "proxy",
    "secure",
    "tcp",
    "transparent",
    "tunnel"
  ],
  "author": "Leask Wong <i@leaskh.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiangweihewu/socratex-hardened.git"
  },
  "dependencies": {
    "acme-client": "^5.0.0",
    "fast-geoip": "^1.1.88",
    "utilitas": "^1995.1.6"
  },
  "overrides": {
    "utilitas": {
      "mathjs": "15.2.0",
      "file-type": "21.3.4",
      "uuid": "11.1.1"
    }
  }
}
